{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowJs": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*", "e2e/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "public"]
}
