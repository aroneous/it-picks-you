# Cloudflare Pages response headers. See https://developers.cloudflare.com/pages/configuration/headers/
# The service worker and entry files must always be revalidated, or clients can get stuck on an old version.

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Content-hashed by Vite; safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
